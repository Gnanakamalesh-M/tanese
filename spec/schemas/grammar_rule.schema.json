{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gnanakamalesh-M/tanese/spec/schemas/grammar_rule.schema.json",
  "title": "Tanese grammar rule file",
  "description": "A list of grammar rules, per the rule file format locked in docs/SPEC.md.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "category",
      "name",
      "description",
      "reason",
      "inspiration",
      "pattern",
      "valid",
      "invalid",
      "status",
      "since"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^GR-[A-Z]+-[0-9]{3}$",
        "description": "Unique, stable rule id, e.g. GR-PART-003."
      },
      "category": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "reason": {
        "type": "string",
        "minLength": 1,
        "description": "Why this design; alternatives considered."
      },
      "inspiration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "original_feature", "how_modified"],
        "properties": {
          "source": { "enum": ["tamil", "japanese", "none"] },
          "original_feature": { "type": "string", "minLength": 1 },
          "how_modified": { "type": "string", "minLength": 1 }
        }
      },
      "pattern": { "type": "string", "minLength": 1 },
      "valid": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tanese", "roman", "english"],
          "properties": {
            "tanese": { "type": "string", "minLength": 1 },
            "roman": { "type": "string", "minLength": 1 },
            "english": { "type": "string", "minLength": 1 }
          }
        }
      },
      "invalid": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tanese", "roman", "why"],
          "properties": {
            "tanese": { "type": "string", "minLength": 1 },
            "roman": { "type": "string", "minLength": 1 },
            "why": { "type": "string", "minLength": 1 }
          }
        }
      },
      "status": { "enum": ["official", "experimental"] },
      "since": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" }
    }
  }
}
