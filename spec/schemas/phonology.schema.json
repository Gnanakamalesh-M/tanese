{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gnanakamalesh-M/tanese/spec/schemas/phonology.schema.json",
  "title": "Tanese phonology",
  "description": "The sound inventory, mora and syllable structure, and phonotactic constraints. Locked decisions 9-11 in docs/SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "vowels",
    "vowel_length",
    "consonants",
    "gemination",
    "mora_kinds",
    "syllable",
    "accent",
    "allophony",
    "constraints",
    "gaps"
  ],
  "$defs": {
    "prose": { "type": "string", "minLength": 1 },
    "grapheme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2,
      "pattern": "^[a-z]+$",
      "description": "A phoneme is keyed by its romanization grapheme, so this file and spec/romanization.yaml share one key space."
    }
  },
  "properties": {
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "vowels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ipa", "height", "backness"],
        "properties": {
          "id": { "$ref": "#/$defs/grapheme" },
          "ipa": { "type": "string", "minLength": 1 },
          "height": { "enum": ["high", "mid", "low"] },
          "backness": { "enum": ["front", "central", "back"] }
        }
      }
    },
    "vowel_length": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contrastive", "reason"],
      "properties": {
        "contrastive": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/prose" }
      }
    },
    "consonants": {
      "type": "array",
      "minItems": 15,
      "maxItems": 18,
      "description": "Locked decision 9 fixes the size at about 15-18 consonants.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ipa", "place", "manner", "voiced", "geminable"],
        "properties": {
          "id": { "$ref": "#/$defs/grapheme" },
          "ipa": { "type": "string", "minLength": 1 },
          "place": {
            "enum": ["labial", "alveolar", "retroflex", "velar", "palatal", "glottal"]
          },
          "manner": {
            "enum": ["plosive", "nasal", "fricative", "tap", "trill", "lateral", "glide"]
          },
          "voiced": { "type": "boolean" },
          "geminable": { "type": "boolean" }
        }
      }
    },
    "gemination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "alternatives", "problems"],
      "properties": {
        "reason": { "$ref": "#/$defs/prose" },
        "alternatives": { "$ref": "#/$defs/prose" },
        "problems": { "$ref": "#/$defs/prose" }
      }
    },
    "mora_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "glyph_role"],
        "properties": {
          "id": { "enum": ["syllabic", "length", "nasal", "gem"] },
          "description": { "$ref": "#/$defs/prose" },
          "glyph_role": { "enum": ["base", "mark"] }
        }
      }
    },
    "syllable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "reason"],
      "properties": {
        "template": { "const": "(C)V(N)" },
        "reason": { "$ref": "#/$defs/prose" }
      }
    },
    "accent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "position", "contrastive", "reason"],
      "properties": {
        "type": { "enum": ["fixed", "lexical"] },
        "position": { "type": "string", "minLength": 1 },
        "contrastive": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/prose" }
      }
    },
    "allophony": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "reason"],
      "properties": {
        "rules": { "type": "array" },
        "reason": { "$ref": "#/$defs/prose" }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "description": "Each id is emitted verbatim as a violation code by tanese_nlp.phonology.phonotactics.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^PT-[0-9]{3}$" },
          "name": { "$ref": "#/$defs/prose" },
          "description": { "$ref": "#/$defs/prose" },
          "reason": { "$ref": "#/$defs/prose" },
          "alternatives": { "$ref": "#/$defs/prose" },
          "problems": { "$ref": "#/$defs/prose" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "Mora spellings that the inventory would otherwise allow but which are declared illegal. May be empty.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mora", "reason"],
        "properties": {
          "mora": { "type": "string", "pattern": "^[a-z]{1,3}$" },
          "reason": { "$ref": "#/$defs/prose" }
        }
      }
    }
  }
}
