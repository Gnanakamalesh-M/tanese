{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gnanakamalesh-M/tanese/spec/schemas/script.schema.json",
  "title": "Tanese script",
  "description": "The featural abugida: hand-designed atoms, the bases built from them, and one mora id per legal mora (locked decision 13).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "design",
    "inherent_vowel",
    "virama",
    "inherent_vowel_reason",
    "writing",
    "atoms",
    "bases",
    "moras"
  ],
  "$defs": {
    "prose": { "type": "string", "minLength": 1 },
    "atom_id": { "type": "string", "pattern": "^[A-Z]+-[A-Z]+$" },
    "atom": {
      "type": "object",
      "required": ["id", "shape"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/atom_id" },
        "shape": { "$ref": "#/$defs/prose" },
        "reason": { "$ref": "#/$defs/prose" },
        "place": { "type": "string", "minLength": 1 },
        "manner": { "type": "string", "minLength": 1 },
        "vowel": { "type": "string", "pattern": "^[a-z]$" }
      }
    },
    "atom_group": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/atom" }
    }
  },
  "properties": {
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason", "alternatives", "problems"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "reason": { "$ref": "#/$defs/prose" },
        "alternatives": { "$ref": "#/$defs/prose" },
        "problems": { "$ref": "#/$defs/prose" }
      }
    },
    "inherent_vowel": { "enum": ["none"] },
    "virama": { "enum": ["none"] },
    "inherent_vowel_reason": { "$ref": "#/$defs/prose" },
    "writing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "marks_follow"],
      "properties": {
        "direction": { "enum": ["left-to-right", "right-to-left"] },
        "marks_follow": { "$ref": "#/$defs/prose" }
      }
    },
    "atoms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "manner_marks", "vowel_marks", "standalone_marks"],
      "description": "The only hand-designed shapes in the script. Everything else is composed from these.",
      "properties": {
        "frames": { "$ref": "#/$defs/atom_group" },
        "manner_marks": { "$ref": "#/$defs/atom_group" },
        "vowel_marks": { "$ref": "#/$defs/atom_group" },
        "standalone_marks": { "$ref": "#/$defs/atom_group" }
      }
    },
    "bases": {
      "type": "array",
      "minItems": 1,
      "description": "One base per onset plus the zero-onset carrier; each is a frame and a manner mark.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "onset", "composition"],
        "properties": {
          "id": { "type": "string", "pattern": "^BASE-[A-Z]+$" },
          "onset": {
            "type": ["string", "null"],
            "pattern": "^[a-z]{1,2}$",
            "description": "The consonant grapheme, or null for the vowel carrier."
          },
          "composition": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "$ref": "#/$defs/atom_id" }
          }
        }
      }
    },
    "moras": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per legal mora. tests/unit/test_spec_consistency.py asserts this set equals the legal mora set derived from spec/phonology.yaml.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mora", "kind", "composition", "pua"],
        "properties": {
          "id": { "type": "string", "pattern": "^TS-[A-Z]+$" },
          "mora": {
            "type": ["string", "null"],
            "pattern": "^[a-z]{1,3}$",
            "description": "The romanized spelling, or null for the standalone marks, which spell nothing on their own."
          },
          "kind": { "enum": ["syllabic", "length", "nasal", "gem"] },
          "composition": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "type": "string", "pattern": "^[A-Z]+-[A-Z]+$" }
          },
          "pua": {
            "type": "string",
            "pattern": "^U\\+[E-F][0-9A-F]{3}$",
            "description": "Private Use Area codepoint for Phase 6 rendering. Not a Unicode proposal (out of scope)."
          }
        }
      }
    }
  }
}
